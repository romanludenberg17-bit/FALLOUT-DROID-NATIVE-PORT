+// Android: gethostname() is "localhost", so the hostname lookup below always
+// yields 127.0.0.1 and LAN sessions advertise an unreachable host. Pick the
+// Wi-Fi / hotspot / Ethernet interface instead. REX_LAN_IPV4 (set by the
+// launcher from WifiManager) wins. Returns 0 when nothing usable is found.
+uint32_t PreferredLanIpv4() {
+  if (const char* forced = std::getenv("REX_LAN_IPV4"); forced && *forced) {
+    in_addr address{};
+    if (inet_pton(AF_INET, forced, &address) == 1 && address.s_addr) return address.s_addr;
+  }
+#if !REX_PLATFORM_WIN32
+  ifaddrs* list = nullptr;
+  if (getifaddrs(&list) != 0) return 0;
+  uint32_t best = 0;
+  int best_rank = -1;
+  for (auto* current = list; current; current = current->ifa_next) {
+    if (!current->ifa_addr || current->ifa_addr->sa_family != AF_INET) continue;
+    if (!(current->ifa_flags & IFF_UP) || (current->ifa_flags & IFF_LOOPBACK)) continue;
+    const uint32_t address = reinterpret_cast<const sockaddr_in*>(current->ifa_addr)->sin_addr.s_addr;
+    const uint32_t host = ntohl(address);
+    const bool is_private = (host >> 24) == 10 || (host >> 20) == 0xAC1 || (host >> 16) == 0xC0A8;
+    const std::string_view name = current->ifa_name ? current->ifa_name : "";
+    int rank = is_private ? 1 : 0;
+    if (name.starts_with("wlan") || name.starts_with("ap") || name.starts_with("swlan") ||
+        name.starts_with("softap") || name.starts_with("eth") || name.starts_with("p2p")) {
+      rank += 4;
+    }
+    if (name.starts_with("rmnet") || name.starts_with("ccmni") || name.starts_with("tun") ||
+        name.starts_with("dummy")) {
+      rank -= 4;
+    }
+    if (rank > best_rank) {
+      best_rank = rank;
+      best = address;
+    }
+  }
+  freeifaddrs(list);
+  return best;
+#else
+  return 0;
+#endif
+}
