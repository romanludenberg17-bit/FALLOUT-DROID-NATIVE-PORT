+namespace {
+// User icons in LibertyRecomp/touch-icons win; otherwise the bundled set the
+// launcher unpacks into Resources/touch-icons.
+std::filesystem::path TouchIconDirectory(const std::filesystem::path& liberty_root) {
+  std::error_code error;
+  const auto user = liberty_root / "touch-icons";
+  if (std::filesystem::is_directory(user, error) && !std::filesystem::is_empty(user, error)) return user;
+  return rex::filesystem::GetResourcesFolder() / "touch-icons";
+}
+}  // namespace
