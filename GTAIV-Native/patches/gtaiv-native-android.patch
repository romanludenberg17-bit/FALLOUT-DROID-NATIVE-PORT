@@ -0,0 +1,202 @@
+// JNI for the 4NMP launcher's touch layout editor (com.libertyrecomp.TouchSettings),
+// implemented over this engine's own touch layout and settings code, so the
+// editor and the in-game overlay share one action numbering and one file
+// (LibertyRecomp/touch-controls.ini). Coordinates: the game lays the overlay
+// out in window points (pixels / display density); Java works in pixels.
+#include <jni.h>
+
+#include <cmath>
+#include <cstdio>
+#include <fstream>
+#include <map>
+#include <mutex>
+#include <string>
+
+#include "input/context_touch_layout.h"
+#include "input/context_touch_settings.h"
+
+namespace {
+using namespace gta4::input;
+
+std::mutex g_mutex;
+ContextTouchLayout g_layout;
+float g_density = 1.0f;
+std::filesystem::path g_extras_path;
+std::map<std::string, std::string> g_extras;  // launcher-only keys (radar_scale, camera_mode, ...)
+
+std::string ToString(JNIEnv* env, jstring value) {
+  if (!value) return {};
+  const char* chars = env->GetStringUTFChars(value, nullptr);
+  std::string out = chars ? chars : "";
+  if (chars) env->ReleaseStringUTFChars(value, chars);
+  return out;
+}
+
+void LoadExtras() {
+  g_extras.clear();
+  std::ifstream file(g_extras_path);
+  std::string key, value;
+  while (file >> key >> value) g_extras[key] = value;
+}
+
+bool SaveExtras() {
+  if (g_extras_path.empty()) return false;
+  std::ofstream file(g_extras_path, std::ios::trunc);
+  for (const auto& [key, value] : g_extras) file << key << ' ' << value << '\n';
+  return static_cast<bool>(file);
+}
+
+void AppendEscaped(std::string& out, const char* text) {
+  for (const char* c = text; *c; ++c) {
+    if (*c == '"' || *c == '\\') out += '\\';
+    if (static_cast<unsigned char>(*c) >= 0x20) out += *c;
+  }
+}
+
+std::string PreferenceValue(const std::string& key) {
+  const auto p = GetContextTouchPreferences();
+  char buffer[32];
+  auto number = [&](float v) { std::snprintf(buffer, sizeof(buffer), "%.2f", v); return std::string(buffer); };
+  if (key == "button_scale") return number(p.button_scale);
+  if (key == "opacity") return number(p.opacity);
+  if (key == "camera_sensitivity") return number(p.camera_sensitivity);
+  if (key == "aim_sensitivity") return number(p.aim_sensitivity);
+  if (key == "vehicle_sensitivity") return number(p.vehicle_sensitivity);
+  if (key == "flight_sensitivity") return number(p.flight_sensitivity);
+  if (key == "left_handed") return p.left_handed ? "true" : "false";
+  if (key == "floating_stick") return p.floating_stick ? "true" : "false";
+  if (key == "invert_camera_y") return p.invert_camera_y ? "true" : "false";
+  if (key == "haptics") return p.haptics ? "true" : "false";
+  const auto found = g_extras.find(key);
+  return found != g_extras.end() ? found->second : std::string();
+}
+
+bool SetPreference(const std::string& key, const std::string& value) {
+  auto p = GetContextTouchPreferences();
+  const bool flag = value == "true" || value == "1";
+  const float number = std::strtof(value.c_str(), nullptr);
+  if (key == "button_scale") p.button_scale = number;
+  else if (key == "opacity") p.opacity = number;
+  else if (key == "camera_sensitivity") p.camera_sensitivity = number;
+  else if (key == "aim_sensitivity") p.aim_sensitivity = number;
+  else if (key == "vehicle_sensitivity") p.vehicle_sensitivity = number;
+  else if (key == "flight_sensitivity") p.flight_sensitivity = number;
+  else if (key == "left_handed") p.left_handed = flag;
+  else if (key == "floating_stick") p.floating_stick = flag;
+  else if (key == "invert_camera_y") p.invert_camera_y = flag;
+  else if (key == "haptics") p.haptics = flag;
+  else {
+    if (key.empty() || key.find_first_of(" \n") != std::string::npos ||
+        value.find_first_of(" \n") != std::string::npos) return false;
+    g_extras[key] = value.empty() ? "-" : value;
+    return true;
+  }
+  SetContextTouchPreferences(p);
+  return true;
+}
+}  // namespace
+
+extern "C" {
+
+JNIEXPORT void JNICALL Java_com_libertyrecomp_TouchSettings_nativeOpen(JNIEnv* env, jclass, jstring path) {
+  std::lock_guard lock(g_mutex);
+  const std::filesystem::path file = ToString(env, path);
+  ConfigureContextTouchSettings(file);
+  g_extras_path = file;
+  g_extras_path += ".launcher";
+  LoadExtras();
+}
+
+JNIEXPORT jstring JNICALL Java_com_libertyrecomp_TouchSettings_nativeGet(JNIEnv* env, jclass, jstring key) {
+  std::lock_guard lock(g_mutex);
+  return env->NewStringUTF(PreferenceValue(ToString(env, key)).c_str());
+}
+
+JNIEXPORT jboolean JNICALL Java_com_libertyrecomp_TouchSettings_nativeSet(JNIEnv* env, jclass, jstring key,
+                                                                          jstring value) {
+  std::lock_guard lock(g_mutex);
+  return SetPreference(ToString(env, key), ToString(env, value)) ? JNI_TRUE : JNI_FALSE;
+}
+
+JNIEXPORT jboolean JNICALL Java_com_libertyrecomp_TouchSettings_nativeSave(JNIEnv*, jclass) {
+  std::lock_guard lock(g_mutex);
+  const bool extras = SaveExtras();
+  return FlushContextTouchSettings() && extras ? JNI_TRUE : JNI_FALSE;
+}
+
+JNIEXPORT void JNICALL Java_com_libertyrecomp_TouchSettings_nativeReset(JNIEnv*, jclass, jboolean all) {
+  std::lock_guard lock(g_mutex);
+  if (all == JNI_TRUE) {
+    for (int mode = 1; mode <= static_cast<int>(ContextTouchMode::kMap); ++mode) {
+      auto layout = g_layout;
+      layout.mode = static_cast<ContextTouchMode>(mode);
+      RestoreContextTouchLayout(layout);
+    }
+    SetContextTouchPreferences({});
+    g_extras.clear();
+  } else {
+    RestoreContextTouchLayout(g_layout);
+  }
+}
+
+// [{"action":N,"x":px,"y":px,"r":px,"label":"..","icon":".."}, ...]
+JNIEXPORT jstring JNICALL Java_com_libertyrecomp_TouchSettings_nativeLayout(JNIEnv* env, jclass, jint mode,
+                                                                            jfloat width, jfloat height,
+                                                                            jfloat density) {
+  std::lock_guard lock(g_mutex);
+  g_density = std::isfinite(density) && density > 0.1f ? density : 1.0f;
+  if (mode <= 0 || mode > static_cast<int>(ContextTouchMode::kMap) || !(width > 0.0f) || !(height > 0.0f)) {
+    return env->NewStringUTF("[]");
+  }
+  const float w = width / g_density, h = height / g_density;
+  ContextTouchViewport viewport{
+      .output_width = w, .output_height = h,
+      .physical_output_x = 0.0f, .physical_output_y = 0.0f,
+      .physical_output_width = width, .physical_output_height = height,
+      .physical_surface_width = width, .physical_surface_height = height,
+      .safe_x = 0.0f, .safe_y = 0.0f, .safe_width = w, .safe_height = h,
+      .generation = 1, .valid = true, .focused = true,
+      .logical_width = w, .logical_height = h, .host_space = true};
+  const auto preferences = GetContextTouchPreferences();
+  ContextTouchLayoutOptions options;
+  options.contextual = true;  // the in-game (semantic) layout, not the legacy grid
+  options.editing = true;
+  options.armed = true;
+  options.can_enter_vehicle = true;
+  options.phone_visible = mode == static_cast<int>(ContextTouchMode::kPhone);
+  options.left_handed = preferences.left_handed;
+  options.button_scale = preferences.button_scale;
+  options.opacity = preferences.opacity;
+  g_layout = BuildContextTouchLayout(static_cast<ContextTouchMode>(mode), viewport, {}, options);
+  ApplyContextTouchSavedLayout(g_layout);
+  std::string json = "[";
+  char number[160];
+  for (size_t i = 0; i < g_layout.control_count; ++i) {
+    const auto& c = g_layout.controls[i];
+    if (!c.visible || c.action == TouchAction::kNone || c.kind == ContextTouchControlKind::kLookSurface ||
+        c.kind == ContextTouchControlKind::kUtility) continue;
+    if (json.size() > 1) json += ',';
+    std::snprintf(number, sizeof(number), "{\"action\":%u,\"x\":%.2f,\"y\":%.2f,\"r\":%.2f,\"label\":\"",
+                  static_cast<unsigned>(c.action), c.center_x * g_density, c.center_y * g_density,
+                  c.radius * g_density);
+    json += number;
+    AppendEscaped(json, c.label.data());
+    json += "\",\"icon\":\"";
+    AppendEscaped(json, c.icon_id.data());
+    json += "\"}";
+  }
+  json += ']';
+  return env->NewStringUTF(json.c_str());
+}
+
+JNIEXPORT jboolean JNICALL Java_com_libertyrecomp_TouchSettings_nativeMove(JNIEnv*, jclass, jint action, jfloat x,
+                                                                           jfloat y, jfloat radius) {
+  std::lock_guard lock(g_mutex);
+  if (action <= 0 || action >= static_cast<int>(TouchAction::kCount)) return JNI_FALSE;
+  return SetContextTouchPlacement(g_layout, static_cast<TouchAction>(action), x / g_density, y / g_density,
+                                  radius / g_density)
+             ? JNI_TRUE
+             : JNI_FALSE;
+}
+
+}  // extern "C"
