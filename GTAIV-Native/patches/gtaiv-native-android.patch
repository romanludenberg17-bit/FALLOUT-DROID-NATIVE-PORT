+package com.libertyrecomp;
+
+import android.os.Build;
+
+import java.util.Locale;
+
+/** Picks the first-launch settings profile from the SoC. */
+final class DeviceProfile {
+    private DeviceProfile() {}
+
+    static boolean isMaliClass() {
+        String soc = "";
+        if (Build.VERSION.SDK_INT >= 31) {
+            soc = (Build.SOC_MANUFACTURER + " " + Build.SOC_MODEL).toLowerCase(Locale.ROOT);
+        }
+        String hw = (Build.HARDWARE + " " + Build.BOARD).toLowerCase(Locale.ROOT);
+        return soc.contains("mediatek") || hw.startsWith("mt") || hw.contains(" mt")
+                || soc.contains("google") || soc.contains("tensor")
+                || hw.contains("exynos") || soc.contains("unisoc") || hw.contains("ums");
+    }
+
+    static String argsAsset() {
+        return isMaliClass() ? "default_args_mali.txt" : "default_args.txt";
+    }
+}
