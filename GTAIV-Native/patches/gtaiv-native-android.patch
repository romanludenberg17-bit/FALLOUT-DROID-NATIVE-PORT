+// Numeric values snap to the nearest listed step so the row always shows one.
+std::string TouchSettingValue(const Setting& setting) {
+  const std::string raw = TouchSettingRawValue(setting.cvar);
+  if (raw == "true" || raw == "false" || raw.empty()) return raw;
+  const double value = std::strtod(raw.c_str(), nullptr);
+  std::string best = raw;
+  double distance = std::numeric_limits<double>::max();
+  for (uint8_t i = 0; i < setting.choice_count; ++i) {
+    const double candidate = std::strtod(std::string(setting.choices[i].value).c_str(), nullptr);
+    if (std::abs(candidate - value) < distance) {
+      distance = std::abs(candidate - value);
+      best = std::string(setting.choices[i].value);
+    }
+  }
+  return best;
+}
