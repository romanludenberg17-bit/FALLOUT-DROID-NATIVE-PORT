+# GTA IV Native - Mali / MediaTek profile (Helio G85/G88/G99, Dimensity, Tensor).
+# Display settings (resolution, AA, VSync, shadows, reflections, draw distance)
+# stay at their console defaults and are changed in the in-game Display menu.
+# Only lossless renderer savings and CPU-side tuning are set here.
+--log_level=warn
+--touch_controls=on
+--gpu_plugin=gta4-native
+--gta4_dynamic_draw_distance=true
+--gta4_dynamic_draw_distance_min=0.80
+--gta4_shadow_distance_scale=1.0
+--gta4_reflection_capture_distance=near
+# Traffic/peds: same 40% as the Adreno profile (CPU bound on 2 big cores).
+--gta4_traffic_density_scale=0.4
+--gta4_parked_car_density_scale=0.4
+--gta4_ped_density_scale=0.4
+--gta4_scenario_ped_density_scale=0.4
+# Lossless renderer savings (identical image, less GPU/driver work).
+--gta4_native_merge_indexed_draws=true
+--gta4_native_skip_invisible_draws=true
+--gta4_native_dedupe_vertex_bindings=true
+--gta4_native_keep_draw_state=true
+--gta4_native_lazy_resolves=true
+--gta4_native_lossless_resolve_optimization=true
+--gta4_native_skip_repeated_clears=true
+--gta4_native_water_reflection_on_demand=true
+--gta4_native_pipeline_prewarm=true
+--gta4_native_async_command_retire=true
+--gta4_native_async_constant_release=true
+--gta4_native_pipelined_recording=true
+--gta4_native_recheck_vertex_textures=true
+# FP32 kept: relaxed precision changes the image.
+--gta4_native_fs_relaxed_precision=false
+# Frame pacing and threads.
+--gta4_native_max_queued_frames=3
+--gta4_frame_wait_sleep=true
+--android_perf_hint=true
+--android_pin_hot_threads=true
+--vulkan_native_queue_separation=false
+--gta4_fps_guard=0
+# Streaming: deadline-ordered, prefetch limited for 4-6 GB RAM.
+--gta4_streaming_modern=true
+--gta4_streaming_deadline_order=true
+--gta4_streaming_budget_scale=1.0
+--gta4_streaming_prefetch_pending_limit=256
+--gta4_native_vector_fonts=false
+--user_language=4
diff --git a/os/android/app/src/main/java/com/libertyrecomp/CoopLan.java b/os/android/app/src/main/java/com/libertyrecomp/CoopLan.java
new file mode 100644
index 0000000..435b864
--- /dev/null
+++ b/os/android/app/src/main/java/com/libertyrecomp/CoopLan.java
@@ -0,0 +1,88 @@
+package com.libertyrecomp;
+
+import android.content.Context;
+import android.net.wifi.WifiManager;
+import android.os.Build;
+import android.util.Log;
+
+import java.net.Inet4Address;
+import java.net.InetAddress;
+import java.net.NetworkInterface;
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * Serverless co-op: the game's own Xbox System Link multiplayer over the
+ * runtime's LAN backend (multicast discovery on 239.255.42.99, direct UDP
+ * between peers). Works on one Wi-Fi network or on one phone's hotspot.
+ */
+final class CoopLan {
+    private static final String TAG = "CoopLan";
+
+    private CoopLan() {}
+
+    /** Tells the runtime which IPv4 address is the LAN one (REX_LAN_IPV4). */
+    static void prepare(Context context) {
+        String address = hotspotOrWifiAddress(context);
+        if (address != null) {
+            LibertyActivity.setenv("REX_LAN_IPV4", address);
+            Log.i(TAG, "LAN address " + address);
+        }
+    }
+
+    static WifiManager.MulticastLock acquireMulticastLock(Context context) {
+        try {
+            WifiManager wifi = (WifiManager) context.getApplicationContext()
+                    .getSystemService(Context.WIFI_SERVICE);
+            if (wifi == null) return null;
+            WifiManager.MulticastLock lock = wifi.createMulticastLock("gta4-coop");
+            lock.setReferenceCounted(false);
+            lock.acquire();
+            return lock;
+        } catch (RuntimeException e) {
+            Log.w(TAG, "multicast lock unavailable", e);
+            return null;
+        }
+    }
+
+    /** LAN backend and a player name unless args.txt already chooses them. */
+    static void addArguments(List<String> arguments) {
+        boolean backend = false, name = false;
+        for (String argument : arguments) {
+            if (argument.startsWith("--gta4_multiplayer_backend")) backend = true;
+            if (argument.startsWith("--gta4_player_name")) name = true;
+        }
+        if (!backend) arguments.add("--gta4_multiplayer_backend=lan");
+        if (!name) {
+            String model = Build.MODEL == null ? "Player" : Build.MODEL.replaceAll("[^A-Za-z0-9]", "");
+            if (model.isEmpty()) model = "Player";
+            if (model.length() > 12) model = model.substring(0, 12);
+            arguments.add("--gta4_player_name=Nico" + model);
+        }
+    }
+
+    private static String hotspotOrWifiAddress(Context context) {
+        String best = null;
+        int bestRank = -1;
+        try {
+            for (NetworkInterface nif : Collections.list(NetworkInterface.getNetworkInterfaces())) {
+                if (!nif.isUp() || nif.isLoopback()) continue;
+                String n = nif.getName();
+                int rank;
+                if (n.startsWith("ap") || n.startsWith("swlan") || n.startsWith("softap")) rank = 3;
+                else if (n.startsWith("wlan") || n.startsWith("eth")) rank = 2;
+                else if (n.startsWith("p2p")) rank = 1;
+                else continue;
+                for (InetAddress a : Collections.list(nif.getInetAddresses())) {
+                    if (a instanceof Inet4Address && a.isSiteLocalAddress() && rank > bestRank) {
+                        best = a.getHostAddress();
+                        bestRank = rank;
+                    }
+                }
+            }
+        } catch (Exception e) {
+            Log.w(TAG, "interface scan failed", e);
+        }
+        return best;
+    }
+}
