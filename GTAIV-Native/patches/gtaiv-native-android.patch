+// JNI entry points declared by the 4NMP launcher's LibertyActivity (called on
+// every pause / resume). This engine saves its pipeline cache by itself, and
+// haptics go through SDL, so both only record the state.
+#include <jni.h>
+#include <atomic>
+#include <SDL3/SDL_system.h>
+
+namespace {
+std::atomic<bool> g_game_haptics_available{false};
+}
+
+extern "C" JNIEXPORT void JNICALL
+Java_com_libertyrecomp_LibertyActivity_nativeCheckpointGpuCache(JNIEnv*, jclass) {}
+
+namespace {
+jobject g_multicast_lock = nullptr;
+
+// LAN co-op discovery is multicast; Wi-Fi drivers drop inbound multicast
+// unless an app holds a WifiManager.MulticastLock (the 4NMP shell takes none).
+void AcquireMulticastLock(JNIEnv* env) {
+  if (g_multicast_lock || !env) return;
+  jobject activity = static_cast<jobject>(SDL_GetAndroidActivity());
+  if (!activity) return;
+  auto clear = [env] { if (env->ExceptionCheck()) env->ExceptionClear(); };
+  jclass context_class = env->FindClass("android/content/Context");
+  jmethodID get_app = env->GetMethodID(context_class, "getApplicationContext", "()Landroid/content/Context;");
+  jobject app = env->CallObjectMethod(activity, get_app);
+  clear();
+  jmethodID get_service =
+      env->GetMethodID(context_class, "getSystemService", "(Ljava/lang/String;)Ljava/lang/Object;");
+  jstring wifi_name = env->NewStringUTF("wifi");
+  jobject wifi = app ? env->CallObjectMethod(app, get_service, wifi_name) : nullptr;
+  clear();
+  if (wifi) {
+    jclass wifi_class = env->FindClass("android/net/wifi/WifiManager");
+    jmethodID create = env->GetMethodID(wifi_class, "createMulticastLock",
+                                        "(Ljava/lang/String;)Landroid/net/wifi/WifiManager$MulticastLock;");
+    jstring tag = env->NewStringUTF("gta4-coop");
+    jobject lock = env->CallObjectMethod(wifi, create, tag);
+    clear();
+    if (lock) {
+      jclass lock_class = env->GetObjectClass(lock);
+      env->CallVoidMethod(lock, env->GetMethodID(lock_class, "setReferenceCounted", "(Z)V"), JNI_FALSE);
+      clear();
+      env->CallVoidMethod(lock, env->GetMethodID(lock_class, "acquire", "()V"));
+      if (env->ExceptionCheck()) {
+        env->ExceptionClear();  // CHANGE_WIFI_MULTICAST_STATE missing
+      } else {
+        g_multicast_lock = env->NewGlobalRef(lock);
+      }
+    }
+  }
+  clear();
+  env->DeleteLocalRef(activity);
+}
+}  // namespace
+
+extern "C" JNIEXPORT void JNICALL
+Java_com_libertyrecomp_LibertyActivity_nativeSetGameHapticsAvailable(JNIEnv* env, jclass,
+                                                                     jboolean available) {
+  g_game_haptics_available.store(available == JNI_TRUE, std::memory_order_relaxed);
+  AcquireMulticastLock(env);
+}
diff --git a/glue/rexglue-sdk-main/gta4-recomp/src/android/android_touch_settings_jni.cpp b/glue/rexglue-sdk-main/gta4-recomp/src/android/android_touch_settings_jni.cpp
