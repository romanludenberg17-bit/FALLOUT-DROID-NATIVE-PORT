+namespace {
+// A ready game folder (default.xex + default.xexp + game.iso or extracted
+// files) somewhere in shared storage, e.g. Download/<app>/game_cache/game.
+// Used when the launcher passed no usable --game_data_root (lost selection
+// after an update, or a folder outside the launcher's default path).
+std::optional<std::filesystem::path> FindReadyGameFolder() {
+#if REX_PLATFORM_ANDROID
+  namespace fs = std::filesystem;
+  const fs::path roots[] = {"/storage/emulated/0/Download", "/storage/emulated/0", "/sdcard/Download"};
+  for (const auto& root : roots) {
+    std::error_code error;
+    if (!fs::is_directory(root, error)) continue;
+    size_t visited = 0;
+    fs::recursive_directory_iterator it(root, fs::directory_options::skip_permission_denied, error);
+    for (; !error && it != fs::recursive_directory_iterator(); it.increment(error)) {
+      if (++visited > 20000) break;
+      const auto& path = it->path();
+      const auto name = path.filename().string();
+      if (it.depth() >= 5 || name.starts_with(".") || name == "Android" || name == "DCIM" ||
+          name == "Pictures" || name == "Movies" || name == "Music") {
+        if (it->is_directory(error)) it.disable_recursion_pending();
+        continue;
+      }
+      if (!it->is_directory(error) || !fs::is_regular_file(path / "default.xex", error)) continue;
+      if (!fs::is_regular_file(path / "game.iso", error) && !fs::exists(path / "common.rpf", error))
+        continue;
+      if (gta4::install::IsInstallReady(path, nullptr)) return path;
+    }
+  }
+#endif
+  return std::nullopt;
+}
