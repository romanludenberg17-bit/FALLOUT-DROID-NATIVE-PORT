+/// [nvport] The creator's words in the chosen language (`fnv_util::words`): the whole text
+/// when the language has a line for it, else word by word (the FaceGen controls' names come
+/// from the game's data: "Skin Tint", "Brow Ridge - high / low"), else as it is.
+pub fn translated(s: &str) -> std::borrow::Cow<'_, str> {
+    use fnv_util::words;
+    let whole = words::tr_str(s);
+    if !std::ptr::eq(whole, s) || words::language() == "en" {
+        return std::borrow::Cow::Borrowed(whole);
+    }
+    let mut out = String::with_capacity(s.len() * 2);
+    let mut word = String::new();
+    let mut changed = false;
+    let mut flush = |word: &mut String, out: &mut String, changed: &mut bool| {
+        if word.is_empty() {
+            return;
+        }
+        let t = words::tr_str(word);
+        *changed |= t != word.as_str();
+        out.push_str(t);
+        word.clear();
+    };
+    for ch in s.chars() {
+        if ch.is_alphanumeric() || ch == '\'' {
+            word.push(ch);
+        } else {
+            flush(&mut word, &mut out, &mut changed);
+            out.push(ch);
+        }
+    }
+    flush(&mut word, &mut out, &mut changed);
+    if changed { std::borrow::Cow::Owned(out) } else { std::borrow::Cow::Borrowed(s) }
+}
