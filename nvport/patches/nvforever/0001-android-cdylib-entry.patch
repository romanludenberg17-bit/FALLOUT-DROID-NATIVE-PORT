diff --git a/engine/nvforever/src/phone_cpu.rs b/engine/nvforever/src/phone_cpu.rs
new file mode 100644
index 0000000..46e7d2e
--- /dev/null
+++ b/engine/nvforever/src/phone_cpu.rs
@@ -0,0 +1,209 @@
+//! [nvport] The phone's CPU for the game: the frame's threads on the big cores and the
+//! system told how long a frame should take (Android Performance Hint, ADPF), so the
+//! governor raises the clocks before a frame runs late instead of after.
+//!
+//! Big cores are those with at least 60 % of the largest `cpu_capacity` (the scheduler's
+//! own measure; `cpuinfo_max_freq` where it is missing). With four or more of them the
+//! main thread, the render thread and Bevy's compute pool run there only, the pool one
+//! thread smaller than the big cores; the file and async pools (loading, decoding) keep
+//! every core. With fewer, only the main and render threads are pinned.
+//! `NVF_NO_PIN=1` leaves every thread to the scheduler.
+
+use bevy::prelude::*;
+use std::sync::OnceLock;
+use std::sync::atomic::{AtomicI32, AtomicU64, Ordering};
+
+static BIG: OnceLock<Vec<usize>> = OnceLock::new();
+static ALL: OnceLock<Vec<usize>> = OnceLock::new();
+
+fn read_num(path: String) -> Option<u64> {
+    std::fs::read_to_string(path).ok()?.trim().parse().ok()
+}
+
+fn cores() -> (&'static [usize], &'static [usize]) {
+    let all = ALL.get_or_init(|| {
+        let n = std::thread::available_parallelism().map_or(8, |n| n.get()).max(1);
+        let mut v: Vec<usize> = (0..16).filter(|i| std::path::Path::new(&format!("/sys/devices/system/cpu/cpu{i}")).exists()).collect();
+        if v.is_empty() {
+            v = (0..n).collect();
+        }
+        v
+    });
+    let big = BIG.get_or_init(|| {
+        let measure = |i: usize| {
+            read_num(format!("/sys/devices/system/cpu/cpu{i}/cpu_capacity"))
+                .or_else(|| read_num(format!("/sys/devices/system/cpu/cpu{i}/cpufreq/cpuinfo_max_freq")))
+                .unwrap_or(0)
+        };
+        let m: Vec<(usize, u64)> = all.iter().map(|&i| (i, measure(i))).collect();
+        let top = m.iter().map(|(_, c)| *c).max().unwrap_or(0);
+        if top == 0 {
+            return all.clone();
+        }
+        let big: Vec<usize> = m.iter().filter(|(_, c)| *c * 10 >= top * 6).map(|(i, _)| *i).collect();
+        eprintln!("phone cpu: capacities {m:?}, big cores {big:?}");
+        big
+    });
+    (big, all)
+}
+
+fn pin_current(set: &[usize]) {
+    if set.is_empty() {
+        return;
+    }
+    // SAFETY: a zeroed cpu_set_t filled by libc's helpers, for the calling thread (pid 0).
+    unsafe {
+        let mut s: libc::cpu_set_t = std::mem::zeroed();
+        libc::CPU_ZERO(&mut s);
+        for &c in set {
+            libc::CPU_SET(c, &mut s);
+        }
+        libc::sched_setaffinity(0, std::mem::size_of::<libc::cpu_set_t>(), &s);
+    }
+}
+
+fn pinning() -> bool {
+    std::env::var_os("NVF_NO_PIN").is_none()
+}
+
+/// Called on the game's main thread before Bevy starts its threads: the main thread on
+/// the big cores (the render thread, spawned from it, inherits them).
+pub fn pin_main() {
+    if !pinning() {
+        return;
+    }
+    let (big, all) = cores();
+    if big.len() < all.len() {
+        pin_current(big);
+        MAIN_TID.store(unsafe { libc::gettid() }, Ordering::Relaxed);
+    }
+}
+
+/// The task pools: compute on the big cores (four or more), the others on every core.
+pub fn tune(options: &mut bevy::app::TaskPoolOptions) {
+    if !pinning() {
+        return;
+    }
+    let (big, all) = cores();
+    if big.len() >= all.len() {
+        return;
+    }
+    let everywhere: std::sync::Arc<dyn Fn() + Send + Sync> = std::sync::Arc::new(|| pin_current(cores().1));
+    options.io.on_thread_spawn = Some(everywhere.clone());
+    options.async_compute.on_thread_spawn = Some(everywhere.clone());
+    if big.len() >= 4 {
+        let n = big.len() - 1;
+        options.compute.min_threads = n;
+        options.compute.max_threads = n;
+        options.compute.on_thread_spawn = Some(std::sync::Arc::new(|| pin_current(cores().0)));
+        info!("phone cpu: compute pool {n} threads on the big cores, loading pools on all {}", all.len());
+    } else {
+        options.compute.on_thread_spawn = Some(everywhere);
+        info!("phone cpu: {} big cores: only the main and render threads pinned", big.len());
+    }
+}
+
+static MAIN_TID: AtomicI32 = AtomicI32::new(0);
+static RENDER_TID: AtomicI32 = AtomicI32::new(0);
+/// The frame's target in nanoseconds (0: the display's 60 Hz).
+pub static TARGET_NS: AtomicU64 = AtomicU64::new(0);
+
+type GetManager = unsafe extern "C" fn() -> *mut std::ffi::c_void;
+type CreateSession = unsafe extern "C" fn(*mut std::ffi::c_void, *const i32, usize, i64) -> *mut std::ffi::c_void;
+type Report = unsafe extern "C" fn(*mut std::ffi::c_void, i64) -> i32;
+type Update = unsafe extern "C" fn(*mut std::ffi::c_void, i64) -> i32;
+
+struct Hint {
+    session: usize,
+    report: Report,
+    update: Update,
+    target: i64,
+}
+
+fn open_hint(tids: &[i32], target: i64) -> Option<Hint> {
+    // SAFETY: dlopen/dlsym of the platform's libandroid (API 33+); null checked.
+    unsafe {
+        let lib = libc::dlopen(c"libandroid.so".as_ptr(), libc::RTLD_NOW);
+        if lib.is_null() {
+            return None;
+        }
+        let sym = |n: &std::ffi::CStr| libc::dlsym(lib, n.as_ptr());
+        let (g, c, r, u) = (sym(c"APerformanceHint_getManager"), sym(c"APerformanceHint_createSession"), sym(c"APerformanceHint_reportActualWorkDuration"), sym(c"APerformanceHint_updateTargetWorkDuration"));
+        if g.is_null() || c.is_null() || r.is_null() || u.is_null() {
+            return None;
+        }
+        let g: GetManager = std::mem::transmute(g);
+        let c: CreateSession = std::mem::transmute(c);
+        let manager = g();
+        if manager.is_null() {
+            return None;
+        }
+        let session = c(manager, tids.as_ptr(), tids.len(), target);
+        if session.is_null() {
+            return None;
+        }
+        Some(Hint { session: session as usize, report: std::mem::transmute(r), update: std::mem::transmute(u), target })
+    }
+}
+
+/// The render thread's id, from a system that runs there.
+fn note_render_thread() {
+    if RENDER_TID.load(Ordering::Relaxed) == 0 {
+        // SAFETY: gettid has no preconditions.
+        RENDER_TID.store(unsafe { libc::gettid() }, Ordering::Relaxed);
+    }
+}
+
+#[derive(Default)]
+struct HintState {
+    hint: Option<Hint>,
+    tried: bool,
+    frames: u32,
+}
+
+/// Each frame's length to the performance hint session (main and render threads).
+fn report_frame(time: Res<Time<Real>>, mut st: Local<HintState>) {
+    st.frames += 1;
+    if MAIN_TID.load(Ordering::Relaxed) == 0 {
+        // SAFETY: as above.
+        MAIN_TID.store(unsafe { libc::gettid() }, Ordering::Relaxed);
+    }
+    let target = match TARGET_NS.load(Ordering::Relaxed) {
+        0 => 16_666_667,
+        t => t as i64,
+    };
+    if !st.tried && st.frames > 120 {
+        st.tried = true;
+        let mut tids = vec![MAIN_TID.load(Ordering::Relaxed)];
+        let r = RENDER_TID.load(Ordering::Relaxed);
+        if r != 0 && r != tids[0] {
+            tids.push(r);
+        }
+        st.hint = open_hint(&tids, target);
+        info!("phone cpu: performance hint session {} (threads {tids:?}, target {:.1} ms)", if st.hint.is_some() { "open" } else { "not available" }, target as f64 / 1e6);
+    }
+    if let Some(h) = st.hint.as_mut() {
+        // SAFETY: a live session from APerformanceHint_createSession.
+        unsafe {
+            if h.target != target {
+                h.target = target;
+                (h.update)(h.session as *mut _, target);
+            }
+            let ns = (time.delta_secs_f64() * 1e9) as i64;
+            if ns > 0 {
+                (h.report)(h.session as *mut _, ns);
+            }
+        }
+    }
+}
+
+pub struct PhoneCpuPlugin;
+
+impl Plugin for PhoneCpuPlugin {
+    fn build(&self, app: &mut App) {
+        app.add_systems(Last, report_frame);
+        if let Some(render) = app.get_sub_app_mut(bevy::render::RenderApp) {
+            render.add_systems(bevy::render::Render, note_render_thread);
+        }
+    }
+}
