+                            named.push(g);
+                        }
+                    }
+                }
+            }
+        };
+        collect(pi, qrec, &mut named);
+        if let Ok(subs) = qrec.subrecords() {
+            if let Some(scri) = subs.iter().find(|s| &s.sig == b"SCRI" && s.data.len() >= 4) {
+                let local = u32::from_le_bytes([scri.data[0], scri.data[1], scri.data[2], scri.data[3]]);
+                if let Some((spi, srec)) = fnv_world::fields::global(lo, pi, local).and_then(|g| fnv_world::fields::winner(lo, g)) {
