+fn other_new_game_start(lo: &fnv_esm::LoadOrder, schema: &fnv_esm::Schema, index: &WorldIndex) -> Result<NewGameStart, String> {
+    let interior_of = |r: u32| index.refs.get(&r).and_then(|e| index.cells.get(&e.cell)).filter(|c| c.world.is_none()).map(|c| c.form_id);
+    let start_at = |r: u32, cell: u32| -> Option<NewGameStart> {
