+        let e = subs.iter().find(|s| &s.sig == b"EDID")?;
+        Some(String::from_utf8_lossy(e.data.split(|&b| b == 0).next().unwrap_or(&[])).into_owned())
+    };
+    let find = |sig: &[u8; 4], name: &str| -> Option<(usize, &fnv_esm::raw::Record)> {
+        for (pi, recs) in lo.records.iter().enumerate().rev() {
+            for rec in recs.iter() {
+                if &rec.header.sig == sig && edid_of(rec).is_some_and(|e| e.eq_ignore_ascii_case(name)) {
