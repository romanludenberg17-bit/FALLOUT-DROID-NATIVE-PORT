+}
+
+pub struct AndroidInputPlugin;
+
+impl Plugin for AndroidInputPlugin {
+    fn build(&self, app: &mut App) {
+        app.add_systems(PreUpdate, drain.before(InputSystems)).add_systems(Last, publish_ui_state);
+    }
+}
+
+fn drain(
+    mut window: Query<(Entity, &mut Window), With<PrimaryWindow>>,
+    mut cursor: MessageWriter<CursorMoved>,
+    mut keys: MessageWriter<KeyboardInput>,
+    mut buttons: MessageWriter<MouseButtonInput>,
+    mut motion: MessageWriter<MouseMotion>,
+    mut wheel: MessageWriter<MouseWheel>,
+) {
+    let events = match QUEUE.lock() {
+        Ok(mut q) if !q.is_empty() => std::mem::take(&mut *q),
+        _ => return,
+    };
+    let Ok((window, mut win)) = window.single_mut() else { return };
+    for e in events {
+        match e {
+            Ev::Key(code, down) => {
+                let state = if down { ButtonState::Pressed } else { ButtonState::Released };
+                if let Some(button) = mouse_button(code) {
+                    buttons.write(MouseButtonInput { button, state, window });
+                } else if let Some(key_code) = key_code(code) {
+                    keys.write(KeyboardInput {
+                        key_code,
+                        logical_key: Key::Unidentified(bevy::input::keyboard::NativeKey::Unidentified),
+                        state,
+                        text: None,
+                        repeat: false,
+                        window,
+                    });
+                }
+            }
+            Ev::Motion(dx, dy) => {
+                motion.write(MouseMotion { delta: Vec2::new(dx, dy) });
+            }
+            Ev::CursorTo(x, y) => {
+                let position = Vec2::new(x, y) / win.scale_factor();
+                let delta = win.cursor_position().map(|p| position - p);
+                win.set_physical_cursor_position(Some(bevy::math::DVec2::new(x as f64, y as f64)));
+                cursor.write(CursorMoved { window, position, delta });
+            }
+            Ev::Scroll(lines) => {
+                wheel.write(MouseWheel { unit: MouseScrollUnit::Line, x: 0.0, y: lines, window, phase: bevy::input::touch::TouchPhase::Moved });
+            }
+        }
+    }
+}
+
+/// The game's own pointer rules (nvf_play::player::grab_cursor) say what is on screen.
+fn publish_ui_state(windows: Query<(&Window, &CursorOptions), With<PrimaryWindow>>) {
+    let Ok((window, cursor)) = windows.single() else { return };
+    let state = if !window.focused || cursor.grab_mode != CursorGrabMode::None {
+        // Out of focus the game frees the pointer whatever it shows: keep every key then.
+        1
+    } else if cursor.visible {
+        2
+    } else {
+        3
+    };
+    UI_STATE.store(state, Ordering::Relaxed);
+}
+
+fn mouse_button(code: i32) -> Option<MouseButton> {
+    Some(match code {
+        272 => MouseButton::Left,
+        273 => MouseButton::Right,
+        274 => MouseButton::Middle,
+        275 => MouseButton::Back,
+        276 => MouseButton::Forward,
+        _ => return None,
+    })
+}
+
+/// Linux evdev key code -> Bevy KeyCode (the keys a PC Fallout uses).
+fn key_code(code: i32) -> Option<KeyCode> {
+    use KeyCode::*;
+    Some(match code {
+        1 => Escape,
+        2 => Digit1, 3 => Digit2, 4 => Digit3, 5 => Digit4, 6 => Digit5,
+        7 => Digit6, 8 => Digit7, 9 => Digit8, 10 => Digit9, 11 => Digit0,
+        12 => Minus, 13 => Equal, 14 => Backspace, 15 => Tab,
+        16 => KeyQ, 17 => KeyW, 18 => KeyE, 19 => KeyR, 20 => KeyT, 21 => KeyY,
+        22 => KeyU, 23 => KeyI, 24 => KeyO, 25 => KeyP,
+        26 => BracketLeft, 27 => BracketRight, 28 => Enter, 29 => ControlLeft,
+        30 => KeyA, 31 => KeyS, 32 => KeyD, 33 => KeyF, 34 => KeyG, 35 => KeyH,
+        36 => KeyJ, 37 => KeyK, 38 => KeyL, 39 => Semicolon, 40 => Quote, 41 => Backquote,
+        42 => ShiftLeft, 43 => Backslash,
+        44 => KeyZ, 45 => KeyX, 46 => KeyC, 47 => KeyV, 48 => KeyB, 49 => KeyN, 50 => KeyM,
+        51 => Comma, 52 => Period, 53 => Slash, 54 => ShiftRight, 55 => NumpadMultiply,
+        56 => AltLeft, 57 => Space, 58 => CapsLock,
+        59 => F1, 60 => F2, 61 => F3, 62 => F4, 63 => F5, 64 => F6, 65 => F7, 66 => F8,
+        67 => F9, 68 => F10, 87 => F11, 88 => F12,
+        97 => ControlRight, 100 => AltRight,
+        102 => Home, 103 => ArrowUp, 104 => PageUp, 105 => ArrowLeft, 106 => ArrowRight,
+        107 => End, 108 => ArrowDown, 109 => PageDown, 110 => Insert, 111 => Delete,
+        _ => return None,
+    })
+}
