+    static BASE: AtomicUsize = AtomicUsize::new(0);
+    static END: AtomicUsize = AtomicUsize::new(0);
+    static LOCK: AtomicBool = AtomicBool::new(false);
+    /// Next free byte; guarded by LOCK.
+    static mut BUMP: usize = 0;
+    /// Free-list heads per class; guarded by LOCK.
+    static mut FREE: [usize; CLASSES] = [0; CLASSES];
+    const CLASSES: usize = 4 * 64;
+
+    /// The class of a size and its block size (one block size per class): 16-byte steps
+    /// up to 64, then four steps per power of two.
+    fn class(size: usize) -> (usize, usize) {
+        let s = size.max(16);
+        if s <= 64 {
+            let i = (s + 15) / 16 - 1;
+            return (i, (i + 1) * 16);
+        }
+        let p = (usize::BITS - 1 - (s - 1).leading_zeros()) as usize; // 2^p < s <= 2^(p+1)
+        let step = 1usize << (p - 2);
+        let q = (s - (1 << p) + step - 1) / step; // 1..=4
+        (4 + (p - 6) * 4 + (q - 1), (1 << p) + q * step)
+    }
+
+    fn lock() {
+        while LOCK.compare_exchange_weak(false, true, Ordering::Acquire, Ordering::Relaxed).is_err() {
+            std::hint::spin_loop();
+        }
+    }
+    fn unlock() {
+        LOCK.store(false, Ordering::Release);
+    }
+
+    /// Reserves the mapping on first use: 16 GiB of address space, else less.
+    fn base() -> usize {
+        let b = BASE.load(Ordering::Acquire);
+        if b != 0 {
+            return b;
+        }
+        for gib in [16usize, 8, 4, 2, 1] {
+            let len = gib << 30;
+            // SAFETY: an anonymous private mapping, no file.
+            let p = unsafe {
+                libc::mmap(
+                    std::ptr::null_mut(),
+                    len,
+                    libc::PROT_READ | libc::PROT_WRITE,
+                    libc::MAP_PRIVATE | libc::MAP_ANONYMOUS | libc::MAP_NORESERVE,
+                    -1,
+                    0,
+                )
+            };
+            if p != libc::MAP_FAILED {
+                let a = p as usize;
+                // SAFETY: under LOCK (the caller holds it).
+                unsafe { BUMP = a };
+                END.store(a + len, Ordering::Release);
+                BASE.store(a, Ordering::Release);
+                return a;
+            }
+        }
+        0
+    }
+
+    pub fn owns(ptr: *mut u8) -> bool {
+        let b = BASE.load(Ordering::Acquire);
+        let a = ptr as usize;
+        b != 0 && a >= b && a < END.load(Ordering::Acquire)
+    }
+
+    pub fn alloc(layout: std::alloc::Layout) -> *mut u8 {
+        // Large blocks come from Scudo's secondary (mmap); a failure there is real.
+        if layout.size() > 1 << 20 {
+            return std::ptr::null_mut();
+        }
+        let (c, block) = class(layout.size());
+        let align = layout.align().max(16);
+        lock();
+        let mut out = 0usize;
+        if base() != 0 {
+            // SAFETY: under LOCK; free-list links live in the freed blocks themselves.
+            unsafe {
+                let head = FREE[c];
+                if head != 0 && head % align == 0 {
+                    FREE[c] = *(head as *const usize);
+                    out = head;
+                } else {
+                    let start = (BUMP + align - 1) & !(align - 1);
+                    if start + block <= END.load(Ordering::Relaxed) {
+                        BUMP = start + block;
+                        out = start;
+                    }
+                }
+            }
+        }
+        unlock();
+        out as *mut u8
+    }
+
+    pub fn free(ptr: *mut u8, layout: std::alloc::Layout) {
+        let (c, _) = class(layout.size());
+        lock();
+        // SAFETY: under LOCK; the block is ours and at least 16 bytes.
+        unsafe {
+            *(ptr as *mut usize) = FREE[c];
+            FREE[c] = ptr as usize;
+        }
+        unlock();
+    }
+}
