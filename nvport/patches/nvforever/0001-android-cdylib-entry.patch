+            }
+        }
+    }
+    if let Ok(cell_name) = std::env::var("NVF_NEW_GAME_CELL") {
+        if let Some(c) = index.cell_by_name(cell_name.trim()).filter(|c| c.world.is_none()) {
+            let ps: Vec<[f32; 3]> = c.refs.iter().filter_map(|&r| fnv_world::placed::placement(lo, schema, r)).map(|p| p.position).collect();
+            if !ps.is_empty() {
+                let n = ps.len() as f32;
+                let mid = ps.iter().fold([0.0f32; 3], |a, p| [a[0] + p[0] / n, a[1] + p[1] / n, a[2] + p[2] / n]);
+                return Ok(NewGameStart { interior: c.form_id, feet: mid, heading_deg: 0.0 });
+            }
+        }
+    }
+    Err(format!("no start found for quest {quest} (set NVF_NEW_GAME_MARKER or NVF_NEW_GAME_CELL)"))
+}
