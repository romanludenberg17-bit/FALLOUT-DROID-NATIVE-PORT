+    fn build(&self, app: &mut App) {
+        texture_quality_row(app);
+        if let Some(render) = app.get_sub_app_mut(bevy::render::RenderApp) {
+            render.add_systems(
+                bevy::render::Render,
+                transparent_census.after(bevy::render::RenderSystems::PhaseSort).before(bevy::render::RenderSystems::Render),
+            );
+        }
+        app.add_systems(PreUpdate, drain.before(InputSystems)).add_systems(Last, (publish_ui_state, publish_play_flags)).add_systems(PostUpdate, creator_hides_actors).add_systems(PreUpdate, perf_overlay_out_of_menus).add_systems(Last, perf_overlay_out_of_menus).add_systems(PreUpdate, apply_frame_cap).add_systems(Last, frame_log);
+    }
+
+    /// Every plugin has registered its settings rows by now.
+    fn finish(&self, app: &mut App) {
+        phone_settings(app);
+    }
+}
+
+/// The settings page on a phone: the desktop renderer's heavy rows are not offered (hidden
+/// and locked: neither the player nor a quality preset changes them; the launcher keeps
+/// them off in the INI) — upscalers and frame generation, ambient occlusion, the fine,
+/// cloud and terrain shadows and their 4096 maps, the water mirror, reflections and
+/// effects, light shafts, hazes, the terrain blends and smoothing, sharpening, the quality
+/// presets (their Very High turns everything up), and the counter rows a phone cannot
+/// measure. Multisampling stops at 2x (4x and 8x quadruple the picture's memory).
+const PHONE_HIDDEN: &[&str] = &[
+    "upscaler", "upscaler-quality", "dlss-model", "fsr-library", "frame-generation", "frame-generation-frames",
+    "latency-reduction", "shadow-resolution", "ambient-occlusion", "fine-shadows", "cloud-shadows", "terrain-shadows",
+    "terrain-height-blend", "terrain-anti-tiling", "mesh-terrain-blend", "smooth-terrain", "light-shafts", "heat-haze",
+    "desert-haze", "water-reflections", "water-effects", "water-mirror", "sharpen", "quality", "display-sync",
+    "physics-rate", "fps-counter-cpu", "fps-counter-gpu", "fps-counter-vram", "fps-counter-upscaling",
+];
+
+/// [nvport] What a strong phone (the launcher's `NVPORT_FULL_GFX=1`: Snapdragon 7+ Gen 2
+/// and up) still does not get: the desktop-only upscalers, frame generation and latency
+/// rows, and the display sync the launcher owns.
+const STRONG_PHONE_HIDDEN: &[&str] = &[
+    "upscaler", "upscaler-quality", "dlss-model", "fsr-library", "frame-generation", "frame-generation-frames",
+    "latency-reduction", "display-sync", "physics-rate",
+    // Too heavy or broken on a phone's GPU even at the top (alpha35: 4096² maps, terrain
+    // and cloud shadows gave yellow stripes and a lost device).
+    "shadow-resolution", "terrain-shadows", "fine-shadows",
+];
+
+/// [nvport] The texture quality row: the mip levels the textures lose (High 0, Medium 1,
+/// Low 2), kept in `<home>/texture_quality.txt` for the launcher, which passes it as
+/// `NVF_TEX_MIP_SKIP` on the next start (textures are read once).
+static TEXTURE_QUALITY: AtomicI32 = AtomicI32::new(-1);
+
+fn texture_quality_file() -> Option<std::path::PathBuf> {
+    std::env::var_os("NVFOREVER_HOME").map(|h| std::path::PathBuf::from(h).join("texture_quality.txt"))
+}
+
+fn texture_quality() -> i32 {
+    let q = TEXTURE_QUALITY.load(Ordering::Relaxed);
+    if q >= 0 {
+        return q;
+    }
+    let from_file = texture_quality_file().and_then(|f| std::fs::read_to_string(f).ok()).and_then(|t| t.trim().parse::<i32>().ok());
+    let q = from_file.or_else(|| std::env::var("NVF_TEX_MIP_SKIP").ok().and_then(|v| v.trim().parse().ok())).unwrap_or(1).clamp(0, 2);
+    TEXTURE_QUALITY.store(q, Ordering::Relaxed);
+    q
+}
+
+fn texture_quality_row(app: &mut App) {
+    use nvf_play::settings::{add_setting, choice_index, choice_part, Setting, Slider};
+    add_setting(
+        app,
+        Setting::slider(
+            "texture-quality",
+            "Graphics",
+            "Texture Quality",
+            "The textures' detail: High keeps every level, Medium and Low drop one or two (less memory). Takes effect at the next start.",
+            Slider::choice(
+                3,
+                |_| choice_part(texture_quality() as usize, 3),
+                |_, v| {
+                    let q = choice_index(v, 3) as i32;
+                    if q != texture_quality() {
+                        TEXTURE_QUALITY.store(q, Ordering::Relaxed);
+                        if let Some(f) = texture_quality_file() {
+                            let _ = std::fs::write(f, q.to_string());
+                        }
+                        info!("android: texture quality {q} (mip levels dropped) from the next start");
+                    }
+                },
+                |v| ["High", "Medium", "Low"][choice_index(v, 3).min(2)].to_string(),
+            ),
+        ),
+    );
+}
+
+fn phone_settings(app: &mut App) {
+    use nvf_play::settings::{set_choice_unavailable, set_disabled_status, set_shown_when};
+    let strong = std::env::var("NVPORT_FULL_GFX").is_ok_and(|v| v == "1");
+    let hidden: &[&str] = if strong { STRONG_PHONE_HIDDEN } else { PHONE_HIDDEN };
+    for &key in hidden {
+        set_shown_when(app, key, key, |_| false);
+        set_disabled_status(app, key, |_| Some("Not available on a phone"));
+    }
+    // The temporal shadow filter jitters the sun's shadow maps over frames: at a phone's
+    // uneven frame rate far shadows shimmered.
+    set_choice_unavailable(app, "shadow-filter", |_, name| {
+        (name == "Temporal").then(|| "Shimmers at a phone's frame rate: Fast or Smooth".to_string())
+    });
+    if !strong {
+        set_choice_unavailable(app, "anti-aliasing", |_, name| {
+            matches!(name, "4x" | "8x").then(|| "Too heavy for a phone: 2x, FXAA or SMAA".to_string())
+        });
+    }
+}
+
+fn drain(
+    mut window: Query<(Entity, &mut Window), With<PrimaryWindow>>,
+    mut cursor: MessageWriter<CursorMoved>,
+    mut keys: MessageWriter<KeyboardInput>,
+    mut buttons: MessageWriter<MouseButtonInput>,
+    mut motion: MessageWriter<MouseMotion>,
+    mut wheel: MessageWriter<MouseWheel>,
+    // As winit does: every input also as a WindowEvent. The Pip-Boy's screen (its menus
+    // drawn on the model) reads the buttons from there only (nvf_play::pipboy::drive_pointer).
+    mut window_events: MessageWriter<bevy::window::WindowEvent>,
+) {
+    let events = match QUEUE.lock() {
+        Ok(mut q) if !q.is_empty() => std::mem::take(&mut *q),
+        _ => return,
+    };
+    let Ok((window, mut win)) = window.single_mut() else { return };
+    SCALE.store(win.scale_factor().to_bits(), Ordering::Relaxed);
+    for e in events {
+        match e {
+            Ev::Key(code, down) => {
+                let state = if down { ButtonState::Pressed } else { ButtonState::Released };
+                if let Some(button) = mouse_button(code) {
+                    let b = MouseButtonInput { button, state, window };
+                    window_events.write(bevy::window::WindowEvent::MouseButtonInput(b.clone()));
+                    buttons.write(b);
+                } else if let Some(key_code) = key_code(code) {
+                    let k = KeyboardInput {
+                        key_code,
+                        logical_key: logical_key(key_code),
+                        state,
+                        text: None,
+                        repeat: false,
+                        window,
+                    };
+                    window_events.write(bevy::window::WindowEvent::KeyboardInput(k.clone()));
+                    keys.write(k);
+                }
+            }
+            Ev::Char(ch) => {
+                let text = ch.to_string();
+                for state in [ButtonState::Pressed, ButtonState::Released] {
+                    let k = KeyboardInput {
+                        key_code: KeyCode::Unidentified(bevy::input::keyboard::NativeKeyCode::Unidentified),
+                        logical_key: Key::Character(text.as_str().into()),
+                        state,
+                        text: state.is_pressed().then(|| text.as_str().into()),
+                        repeat: false,
+                        window,
+                    };
+                    window_events.write(bevy::window::WindowEvent::KeyboardInput(k.clone()));
+                    keys.write(k);
+                }
+            }
+            Ev::Motion(dx, dy) => {
+                motion.write(MouseMotion { delta: Vec2::new(dx, dy) });
+            }
+            Ev::CursorTo(x, y) => {
+                let position = Vec2::new(x, y) / win.scale_factor();
+                let delta = win.cursor_position().map(|p| position - p);
+                win.set_physical_cursor_position(Some(bevy::math::DVec2::new(x as f64, y as f64)));
+                let c = CursorMoved { window, position, delta };
+                window_events.write(bevy::window::WindowEvent::CursorMoved(c.clone()));
+                cursor.write(c);
+            }
+            Ev::Scroll(lines) => {
+                let w = MouseWheel { unit: MouseScrollUnit::Line, x: 0.0, y: lines, window, phase: bevy::input::touch::TouchPhase::Moved };
+                window_events.write(bevy::window::WindowEvent::MouseWheel(w.clone()));
+                wheel.write(w);
+            }
+        }
+    }
+}
+
+/// The open screen, the most specific first; else the game's own pointer rules
+/// (nvf_play::player::grab_cursor): a grabbed pointer is play, a free one a menu.
+#[allow(clippy::too_many_arguments)]
+fn publish_ui_state(
+    windows: Query<(&Window, &CursorOptions), With<PrimaryWindow>>,
+    main_menu: Option<Res<nvf_play::main_menu::MainMenu>>,
+    creator: Option<Res<nvf_play::creator::CreatorMenu>>,
+    chargen: Option<Res<nvf_play::chargen::ChargenMenus>>,
+    levelup: Option<Res<nvf_play::levelup::LevelUpMenu>>,
+    paused: Option<Res<nvf_play::pause::Paused>>,
+    pipboy: Option<Res<nvf_play::pipboy::PipBoy>>,
+    talk: Option<Res<nvf_play::dialogue_menu::DialogueMenu>>,
+    message: Option<Res<nvf_play::message_menu::MessagePanel>>,
+    menu: Option<Res<nvf_play::menu::ActiveMenu>>,
+    held: Option<Res<nvf_play::dialogue::WorldHeld>>,
+    look: Option<Res<nvf_play::dialogue::FreeLook>>,
+    locks: Option<Res<nvf_play::control::ControlLocks>>,
+    lockpick: Option<Res<nvf_play::lockpick::LockpickScreen>>,
+    console: Option<Res<nvf_play::console::Console>>,
+) {
+    let Ok((window, cursor)) = windows.single() else { return };
+    let state = if console.is_some_and(|c| c.open) {
+        // The console: the touch layer shows a text bar with Android's keyboard.
+        12
+    } else if main_menu.is_some_and(|m| m.open) {
+        6
+    } else if lockpick.is_some_and(|l| l.0.is_some()) {
+        // Picking a lock: the touch layer turns the screwdriver from the left of the screen.
+        11
+    } else if creator.is_some_and(|c| c.is_open()) || chargen.is_some_and(|c| c.progress().is_some()) || levelup.is_some_and(|l| l.progress().is_some()) {
+        7
+    } else if paused.is_some_and(|p| p.0) {
+        8
+    } else if let Some(p) = pipboy.as_ref().filter(|p| p.open()) {
+        // Its map (Data page, local or world map tab): dragged to pan, pinched to zoom.
+        if matches!(p.page, nvf_play::pipboy::Page::Data) && p.tabs[2] <= 1 { 10 } else { 4 }
+    } else if message.is_some_and(|m| m.view.is_some()) {
+        9
+    } else if talk.is_some_and(|t| t.view.is_some()) || held.is_some_and(|h| h.0) || look.is_some_and(|l| l.0) {
+        // The choices, and an actor speaking (free look) between them.
+        5
+    } else if menu.is_some_and(|m| m.0.is_some()) {
+        2
+    } else if locks.is_some_and(|l| l.movement && l.looking) {
+        // A scripted scene: the scripts took both the walk and the look (the birth, the
+        // opening at Doc Mitchell's): nothing on screen to press.
+        3
+    } else if !window.focused || cursor.grab_mode != CursorGrabMode::None {
+        // Out of focus the game frees the pointer whatever it shows: keep every key then.
+        1
+    } else if cursor.visible {
+        2
+    } else {
+        3
+    };
+    UI_STATE.store(state, Ordering::Relaxed);
+}
+
+fn mouse_button(code: i32) -> Option<MouseButton> {
+    Some(match code {
+        272 => MouseButton::Left,
+        273 => MouseButton::Right,
+        274 => MouseButton::Middle,
+        275 => MouseButton::Back,
+        276 => MouseButton::Forward,
+        _ => return None,
+    })
+}
+
+/// Linux evdev key code -> Bevy KeyCode (the keys a PC Fallout uses).
+/// The logical key of the keys text fields read by meaning (the console: Enter,
+/// Backspace, the history arrows).
+fn logical_key(code: KeyCode) -> Key {
+    match code {
+        KeyCode::Enter | KeyCode::NumpadEnter => Key::Enter,
+        KeyCode::Backspace => Key::Backspace,
+        KeyCode::Escape => Key::Escape,
+        KeyCode::Tab => Key::Tab,
+        KeyCode::ArrowUp => Key::ArrowUp,
+        KeyCode::ArrowDown => Key::ArrowDown,
+        KeyCode::ArrowLeft => Key::ArrowLeft,
+        KeyCode::ArrowRight => Key::ArrowRight,
+        KeyCode::PageUp => Key::PageUp,
+        KeyCode::PageDown => Key::PageDown,
+        KeyCode::Delete => Key::Delete,
+        _ => Key::Unidentified(bevy::input::keyboard::NativeKey::Unidentified),
+    }
+}
+
+fn key_code(code: i32) -> Option<KeyCode> {
+    use KeyCode::*;
+    Some(match code {
+        1 => Escape,
+        2 => Digit1, 3 => Digit2, 4 => Digit3, 5 => Digit4, 6 => Digit5,
+        7 => Digit6, 8 => Digit7, 9 => Digit8, 10 => Digit9, 11 => Digit0,
+        12 => Minus, 13 => Equal, 14 => Backspace, 15 => Tab,
+        16 => KeyQ, 17 => KeyW, 18 => KeyE, 19 => KeyR, 20 => KeyT, 21 => KeyY,
+        22 => KeyU, 23 => KeyI, 24 => KeyO, 25 => KeyP,
+        26 => BracketLeft, 27 => BracketRight, 28 => Enter, 29 => ControlLeft,
+        30 => KeyA, 31 => KeyS, 32 => KeyD, 33 => KeyF, 34 => KeyG, 35 => KeyH,
+        36 => KeyJ, 37 => KeyK, 38 => KeyL, 39 => Semicolon, 40 => Quote, 41 => Backquote,
+        42 => ShiftLeft, 43 => Backslash,
+        44 => KeyZ, 45 => KeyX, 46 => KeyC, 47 => KeyV, 48 => KeyB, 49 => KeyN, 50 => KeyM,
+        51 => Comma, 52 => Period, 53 => Slash, 54 => ShiftRight, 55 => NumpadMultiply,
+        56 => AltLeft, 57 => Space, 58 => CapsLock,
+        59 => F1, 60 => F2, 61 => F3, 62 => F4, 63 => F5, 64 => F6, 65 => F7, 66 => F8,
+        67 => F9, 68 => F10, 87 => F11, 88 => F12,
+        97 => ControlRight, 100 => AltRight,
+        102 => Home, 103 => ArrowUp, 104 => PageUp, 105 => ArrowLeft, 106 => ArrowRight,
+        107 => End, 108 => ArrowDown, 109 => PageDown, 110 => Insert, 111 => Delete,
+        _ => return None,
+    })
+}
+
+/// [nvport] Frame times in the run log, always on (the testers' reports): every 10 s of
+/// play the mean FPS, the 1% low, the slowest frame and the count of hitches; a frame over
+/// 120 ms at once (at most one line a second), so a freeze sits next to what was loaded.
+#[derive(Default)]
+struct FrameLog {
+    ms: Vec<f32>,
+    since: f64,
+    last_hitch: f64,
+}
+
+fn frame_log(time: Res<Time<Real>>, mut log: Local<FrameLog>) {
+    let ms = time.delta_secs() * 1000.0;
+    let now = time.elapsed_secs_f64();
+    let state = UI_STATE.load(Ordering::Relaxed);
+    if ms <= 0.0 || state == 0 {
+        return;
+    }
+    if ms > 120.0 && now - log.last_hitch > 1.0 {
+        log.last_hitch = now;
+        info!("frame log: hitch {ms:.0} ms (screen {state})");
+    }
+    if log.since == 0.0 {
+        log.since = now;
+    }
+    log.ms.push(ms);
+    if now - log.since >= 10.0 && log.ms.len() > 30 {
+        let n = log.ms.len();
+        let total: f32 = log.ms.iter().sum();
+        let mut sorted = std::mem::take(&mut log.ms);
+        sorted.sort_by(|a, b| b.total_cmp(a));
+        let low = sorted[(n / 100).min(n - 1)];
+        let over33 = sorted.iter().take_while(|m| **m > 33.4).count();
+        let over50 = sorted.iter().take_while(|m| **m > 50.0).count();
+        info!(
+            "frame log: {:.1} fps over {:.0} s, mean {:.1} ms, 1% low {:.1} ms ({:.0} fps), slowest {:.0} ms, frames >33 ms {over33}, >50 ms {over50} (screen {state})",
+            n as f32 * 1000.0 / total,
+            total / 1000.0,
+            total / n as f32,
+            low,
+            1000.0 / low,
+            sorted[0]
+        );
+        log.since = now;
+        log.ms = sorted;
+        log.ms.clear();
+    }
+}
+
+/// [nvport] Players saw no muzzle flashes, explosions, blood or decals (every blended or
+/// additive thing) while opaque ones showed: every 10 s, the items in each view's
+/// transparent phase, so a report tells "never queued" from "queued but not seen".
+fn transparent_census(phases: Res<bevy::render::render_phase::ViewSortedRenderPhases<bevy::core_pipeline::core_3d::Transparent3d>>, mut last: Local<Option<std::time::Instant>>, mut most: Local<usize>) {
+    let total: usize = phases.0.values().map(|p| p.items.len()).sum();
+    *most = (*most).max(total);
+    let now = std::time::Instant::now();
+    if last.is_some_and(|t| now.duration_since(t).as_secs() < 10) {
+        return;
+    }
+    *last = Some(now);
+    let per_view: Vec<usize> = phases.0.values().map(|p| p.items.len()).collect();
+    info!("render census: transparent items now {total} in {} view(s) {per_view:?}, most in a frame over 10 s {}", per_view.len(), *most);
+    *most = 0;
+}
