+/// [nvport] DXT levels re-encoded as ETC2 (EAC alpha where the texture has any): the same
+/// 4 or 8 bits a texel the GPU would have read as BC. Pixels are decoded, padded to whole
+/// 4x4 blocks and encoded by etcpak. `None`: keep the RGBA8 path.
+#[cfg(target_os = "android")]
+fn dxt_to_etc2(dds: &Dds, base: u32, levels: &[&[u8]], srgb: bool) -> Option<(TextureFormat, Vec<u8>)> {
+    let mut decoded = Vec::with_capacity(levels.len());
+    let mut alpha = dds.format != Format::Dxt1;
+    for (m, l) in levels.iter().enumerate() {
+        let (lw, lh) = dds.header.level_dims(base + m as u32);
+        let px = fnv_dds::decode_blocks(dds.format, lw, lh, l)?;
+        if !alpha && px.chunks_exact(4).any(|p| p[3] < 255) {
+            alpha = true;
+        }
+        decoded.push((lw, lh, px));
+    }
+    let mut out = Vec::new();
+    for (lw, lh, px) in decoded {
+        let (pw, ph) = (lw.div_ceil(4) * 4, lh.div_ceil(4) * 4);
+        // BGRA for etcpak's ETC codecs, edges repeated into the padding.
+        let mut bgra = vec![0u8; (pw * ph * 4) as usize];
+        for y in 0..ph {
+            let sy = y.min(lh - 1);
+            for x in 0..pw {
+                let sx = x.min(lw - 1);
+                let s = ((sy * lw + sx) * 4) as usize;
+                let d = ((y * pw + x) * 4) as usize;
+                bgra[d] = px[s + 2];
+                bgra[d + 1] = px[s + 1];
+                bgra[d + 2] = px[s];
+                bgra[d + 3] = px[s + 3];
+            }
+        }
+        let surface = ctt_etcpak::Surface::new(&bgra, pw, ph);
+        if alpha {
+            out.extend(ctt_etcpak::etc2_rgba::compress_blocks(&surface, true));
+        } else {
+            out.extend(ctt_etcpak::etc2_rgb::compress_blocks(&surface, true));
+        }
+    }
+    let format = match (alpha, srgb) {
+        (true, true) => TextureFormat::Etc2Rgba8UnormSrgb,
+        (true, false) => TextureFormat::Etc2Rgba8Unorm,
+        (false, true) => TextureFormat::Etc2Rgb8UnormSrgb,
+        (false, false) => TextureFormat::Etc2Rgb8Unorm,
+    };
+    Some((format, out))
+}
+
+#[cfg(not(target_os = "android"))]
+fn dxt_to_etc2(_: &Dds, _: u32, _: &[&[u8]], _: bool) -> Option<(TextureFormat, Vec<u8>)> {
+    None
+}
