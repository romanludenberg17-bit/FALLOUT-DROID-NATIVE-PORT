diff --git a/engine/nvforever/src/android_input.rs b/engine/nvforever/src/android_input.rs
new file mode 100644
index 0000000..229cb89
--- /dev/null
+++ b/engine/nvforever/src/android_input.rs
@@ -0,0 +1,446 @@
+//! [nvport] Input from the Android launcher (Fallout Droid): on-screen keys, touch look,
+//! gamepads mapped to PC keys and physical keyboards/mice arrive through JNI
+//! (`com.wastelanddroid.engine.NativeInput`) and are written as Bevy's own input messages,
+//! so every engine system (`ButtonInput<KeyCode>`, `ButtonInput<MouseButton>`,
+//! `AccumulatedMouseMotion`, `AccumulatedMouseScroll`) sees them like desktop input.
+//!
+//! Key codes are Linux evdev codes, the same codes Fallout Droid's layouts store
+//! (`17` = W, `272` = left mouse button, ...).
+
+use std::sync::Mutex;
+
+use bevy::input::keyboard::{Key, KeyboardInput};
+use bevy::input::mouse::{MouseButton, MouseButtonInput, MouseMotion, MouseScrollUnit, MouseWheel};
+use bevy::input::{ButtonState, InputSystems};
+use bevy::prelude::*;
+use bevy::window::{CursorGrabMode, CursorMoved, CursorOptions, PrimaryWindow};
+use std::sync::atomic::{AtomicI32, Ordering};
+
+/// What the game shows, for the launcher's on-screen keys (`NativeInput.uiState`):
+/// 0 not known yet, 1 playing, 2 another menu (container, barter, repair, lockpick, V.A.T.S.
+/// target screen...), 3 a film or a scene (no pointer), 4 the Pip-Boy, 5 a conversation,
+/// 6 the main menu, 7 character creation (face and race, SPECIAL, traits, tag skills, name,
+/// level-up), 8 the pause menu, 9 a message box, 10 the Pip-Boy's map. The launcher keeps
+/// the keys each needs and turns finger drags into wheel steps or a held left button.
+static UI_STATE: AtomicI32 = AtomicI32::new(0);
+
+enum Ev {
+    Key(i32, bool),
+    Motion(f32, f32),
+    Scroll(f32),
+    CursorTo(f32, f32),
+}
+
+static QUEUE: Mutex<Vec<Ev>> = Mutex::new(Vec::new());
+
+fn push(e: Ev) {
+    if let Ok(mut q) = QUEUE.lock() {
+        // A stalled frame must not grow the queue without bound.
+        if q.len() < 4096 {
+            q.push(e);
+        }
+    }
+}
+
+type JEnv = *mut std::ffi::c_void;
+type JClass = *mut std::ffi::c_void;
+
+/// `NativeInput.key(int evdevCode, boolean down)`
+#[unsafe(no_mangle)]
+pub extern "C" fn Java_com_wastelanddroid_engine_NativeInput_key(_e: JEnv, _c: JClass, code: i32, down: u8) {
+    push(Ev::Key(code, down != 0));
+}
+
+/// `NativeInput.mouseMove(float dx, float dy)` — relative motion in pixels.
+#[unsafe(no_mangle)]
+pub extern "C" fn Java_com_wastelanddroid_engine_NativeInput_mouseMove(_e: JEnv, _c: JClass, dx: f32, dy: f32) {
+    push(Ev::Motion(dx, dy));
+}
+
+/// `NativeInput.scroll(float lines)`
+#[unsafe(no_mangle)]
+pub extern "C" fn Java_com_wastelanddroid_engine_NativeInput_scroll(_e: JEnv, _c: JClass, lines: f32) {
+    push(Ev::Scroll(lines));
+}
+
+/// `NativeInput.cursorTo(float x, float y)` — absolute cursor in surface pixels (menus, Pip-Boy).
+#[unsafe(no_mangle)]
+pub extern "C" fn Java_com_wastelanddroid_engine_NativeInput_cursorTo(_e: JEnv, _c: JClass, x: f32, y: f32) {
+    push(Ev::CursorTo(x, y));
+}
+
+/// The window's scale factor (physical / logical pixels), kept by `drain` for the calls below.
+static SCALE: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0x3f80_0000);
+
+fn logical(x: f32, y: f32) -> Vec2 {
+    Vec2::new(x, y) / f32::from_bits(SCALE.load(Ordering::Relaxed)).max(0.01)
+}
+
+/// `NativeInput.quickLootHit(float x, float y)`: the Quick Loot list shows and the point
+/// (surface pixels) is on it.
+#[unsafe(no_mangle)]
+pub extern "C" fn Java_com_wastelanddroid_engine_NativeInput_quickLootHit(_e: JEnv, _c: JClass, x: f32, y: f32) -> u8 {
+    let p = logical(x, y);
+    nvf_play::quick_loot::touch_box().is_some_and(|b| p.x >= b[0] && p.x <= b[2] && p.y >= b[1] && p.y <= b[3]) as u8
+}
+
+/// `NativeInput.quickLootTap(float x, float y)`: a tap on the Quick Loot list (surface
+/// pixels): the row under it is taken.
+#[unsafe(no_mangle)]
+pub extern "C" fn Java_com_wastelanddroid_engine_NativeInput_quickLootTap(_e: JEnv, _c: JClass, x: f32, y: f32) {
+    if let Ok(mut t) = nvf_play::quick_loot::TOUCH_TAP.lock() {
+        *t = Some(logical(x, y));
+    }
+}
+
+/// The launcher's arguments file (`<internal data>/nvport_args.txt`), set by android_main.
+pub static ARGS_FILE: std::sync::OnceLock<std::path::PathBuf> = std::sync::OnceLock::new();
+/// A load or a return to the main menu asked for a fresh run (`NativeInput.restartRequested`).
+static RESTART: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+/// Write the next run's command line (`args`, without the program) under the launcher's
+/// `env:` lines and ask the activity to start the game again.
+pub fn request_restart(args: &[String]) -> Result<(), String> {
+    let file = ARGS_FILE.get().ok_or("no arguments file")?;
+    let old = std::fs::read_to_string(file).unwrap_or_default();
+    let mut text: String = old.lines().filter(|l| l.trim_start().starts_with("env:")).map(|l| format!("{l}\n")).collect();
+    for a in args {
+        text.push_str(a);
+        text.push('\n');
+    }
+    std::fs::write(file, text).map_err(|e| format!("{}: {e}", file.display()))?;
+    RESTART.store(true, Ordering::SeqCst);
+    Ok(())
+}
+
+/// `NativeInput.restartRequested()`.
+#[unsafe(no_mangle)]
+pub extern "C" fn Java_com_wastelanddroid_engine_NativeInput_restartRequested(_e: JEnv, _c: JClass) -> u8 {
+    RESTART.load(Ordering::SeqCst) as u8
+}
+
+/// The engine's main() has returned (Quit, or an error): the activity goes back to the
+/// launcher (`NativeInput.engineExited`).
+static EXITED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+pub fn mark_exited() {
+    EXITED.store(true, Ordering::SeqCst);
+}
+
+/// `NativeInput.engineExited()`.
+#[unsafe(no_mangle)]
+pub extern "C" fn Java_com_wastelanddroid_engine_NativeInput_engineExited(_e: JEnv, _c: JClass) -> u8 {
+    EXITED.load(Ordering::SeqCst) as u8
+}
+
+/// A frame-rate cap the launcher's in-game panel asked for (-1: none pending).
+static FRAME_CAP: AtomicI32 = AtomicI32::new(-1);
+
+/// `NativeInput.setFrameCap(int fps)`: 0 no cap, else frames a second at most; applied on
+/// the next frame, as the settings page's Frame rate limit row sets it.
+#[unsafe(no_mangle)]
+pub extern "C" fn Java_com_wastelanddroid_engine_NativeInput_setFrameCap(_e: JEnv, _c: JClass, fps: i32) {
+    FRAME_CAP.store(fps.max(0), Ordering::Relaxed);
+}
+
+fn apply_frame_cap(pace: Option<ResMut<crate::frame_pace::FramePace>>) {
+    let want = FRAME_CAP.swap(-1, Ordering::Relaxed);
+    if want < 0 {
+        return;
+    }
+    if let Some(mut pace) = pace {
+        pace.cap = want as u32;
+        info!("android: frame-rate cap {} (in-game panel)", want);
+    }
+}
+
+/// What the player may do now, for the keys (`NativeInput.playFlags`): bit 0 a weapon is
+/// drawn, bit 1 fighting is locked by scripts, bit 2 sneaking, bit 3 movement, bit 4 the
+/// Pip-Boy, bit 5 the view (POV), bit 6 something to activate under the crosshair.
+static PLAY_FLAGS: AtomicI32 = AtomicI32::new(0);
+
+/// `NativeInput.playFlags()`: see [`PLAY_FLAGS`].
+#[unsafe(no_mangle)]
+pub extern "C" fn Java_com_wastelanddroid_engine_NativeInput_playFlags(_e: JEnv, _c: JClass) -> i32 {
+    PLAY_FLAGS.load(Ordering::Relaxed)
+}
+
+fn publish_play_flags(weapon: Option<Res<nvf_play::combat::WeaponAnim>>, locks: Option<Res<nvf_play::control::ControlLocks>>, target: Option<Res<nvf_play::activate::Target>>) {
+    let mut f = 0;
+    // Bit 6: something under the crosshair the player can use or talk to (the prompt shows).
+    if target.is_some_and(|t| t.0.is_some()) {
+        f |= 64;
+    }
+    if weapon.is_some_and(|w| w.ready) {
+        f |= 1;
+    }
+    if let Some(l) = locks {
+        if l.fighting {
+            f |= 2;
+        }
+        if l.sneaking {
+            f |= 4;
+        }
+        if l.movement {
+            f |= 8;
+        }
+        if l.pipboy {
+            f |= 16;
+        }
+        if l.pov {
+            f |= 32;
+        }
+    }
+    // Bit 7: the Quick Loot list shows (touch: tap a row to take it, swipe it to scroll).
+    if nvf_play::quick_loot::holds_input() {
+        f |= 128;
+    }
+    PLAY_FLAGS.store(f, Ordering::Relaxed);
+}
+
+/// [nvport] While the character creator is open, the other actors are hidden: the player is
+/// made where the opening stands (Fallout 3: the birth, with the father in front of the
+/// view and the mother behind), and only the player's look is being chosen. Each gets
+/// its own visibility back when the creator closes.
+fn creator_hides_actors(
+    creator: Option<Res<nvf_play::creator::CreatorMenu>>,
+    mut actors: Query<(Entity, &crate::limbs::ActorRig, &mut Visibility)>,
+    mut hidden: Local<Option<Vec<(Entity, Visibility)>>>,
+) {
+    let open = creator.is_some_and(|c| c.is_open());
+    match (open, hidden.is_some()) {
+        (true, false) => {
+            let mut kept = Vec::new();
+            for (e, rig, mut v) in &mut actors {
+                if rig.reference == 0x14 {
+                    continue;
+                }
+                kept.push((e, *v));
+                *v = Visibility::Hidden;
+            }
+            info!("android: character creator: {} actors hidden", kept.len());
+            *hidden = Some(kept);
+        }
+        (false, true) => {
+            for (e, v) in hidden.take().unwrap_or_default() {
+                if let Ok((_, _, mut cur)) = actors.get_mut(e) {
+                    *cur = v;
+                }
+            }
+        }
+        _ => {}
+    }
+}
+
+/// [nvport] The frame-rate counter stays out of the character creator, the character
+/// screens and the Pip-Boy: it sits in their corner on a phone's screen.
+fn perf_overlay_out_of_menus(
+    creator: Option<Res<nvf_play::creator::CreatorMenu>>,
+    chargen: Option<Res<nvf_play::chargen::ChargenMenus>>,
+    pipboy: Option<Res<nvf_play::pipboy::PipBoy>>,
+    mut panels: Query<&mut Visibility, With<crate::perf_overlay::draw::PanelRoot>>,
+) {
+    let hide = creator.is_some_and(|c| c.is_open()) || chargen.is_some_and(|c| c.progress().is_some()) || pipboy.is_some_and(|p| p.shown());
+    crate::perf_overlay::draw::HIDDEN.store(hide, Ordering::Relaxed);
+    let want = if hide { Visibility::Hidden } else { Visibility::Inherited };
+    for mut v in &mut panels {
+        if *v != want {
+            *v = want;
+        }
+    }
+}
+
+/// `NativeInput.uiState()`: see [`UI_STATE`].
+#[unsafe(no_mangle)]
+pub extern "C" fn Java_com_wastelanddroid_engine_NativeInput_uiState(_e: JEnv, _c: JClass) -> i32 {
+    UI_STATE.load(Ordering::Relaxed)
+}
+
+pub struct AndroidInputPlugin;
+
+impl Plugin for AndroidInputPlugin {
+    fn build(&self, app: &mut App) {
+        app.add_systems(PreUpdate, drain.before(InputSystems)).add_systems(Last, (publish_ui_state, publish_play_flags)).add_systems(PostUpdate, creator_hides_actors).add_systems(PreUpdate, perf_overlay_out_of_menus).add_systems(Last, perf_overlay_out_of_menus).add_systems(PreUpdate, apply_frame_cap);
+    }
+
+    /// Every plugin has registered its settings rows by now.
+    fn finish(&self, app: &mut App) {
+        phone_settings(app);
+    }
+}
+
+/// The settings page on a phone: the desktop renderer's heavy rows are not offered (hidden
+/// and locked: neither the player nor a quality preset changes them; the launcher keeps
+/// them off in the INI) — upscalers and frame generation, ambient occlusion, the fine,
+/// cloud and terrain shadows and their 4096 maps, the water mirror, reflections and
+/// effects, light shafts, hazes, the terrain blends and smoothing, sharpening, the quality
+/// presets (their Very High turns everything up), and the counter rows a phone cannot
+/// measure. Multisampling stops at 2x (4x and 8x quadruple the picture's memory).
+const PHONE_HIDDEN: &[&str] = &[
+    "upscaler", "upscaler-quality", "dlss-model", "fsr-library", "frame-generation", "frame-generation-frames",
+    "latency-reduction", "shadow-resolution", "ambient-occlusion", "fine-shadows", "cloud-shadows", "terrain-shadows",
+    "terrain-height-blend", "terrain-anti-tiling", "mesh-terrain-blend", "smooth-terrain", "light-shafts", "heat-haze",
+    "desert-haze", "water-reflections", "water-effects", "water-mirror", "sharpen", "quality", "display-sync",
+    "physics-rate", "fps-counter-cpu", "fps-counter-gpu", "fps-counter-vram", "fps-counter-upscaling",
+];
+
+fn phone_settings(app: &mut App) {
+    use nvf_play::settings::{set_choice_unavailable, set_disabled_status, set_shown_when};
+    for &key in PHONE_HIDDEN {
+        set_shown_when(app, key, key, |_| false);
+        set_disabled_status(app, key, |_| Some("Not available on a phone"));
+    }
+    // The temporal shadow filter jitters the sun's shadow maps over frames: at a phone's
+    // uneven frame rate far shadows shimmered.
+    set_choice_unavailable(app, "shadow-filter", |_, name| {
+        (name == "Temporal").then(|| "Shimmers at a phone's frame rate: Fast or Smooth".to_string())
+    });
+    set_choice_unavailable(app, "anti-aliasing", |_, name| {
+        matches!(name, "4x" | "8x").then(|| "Too heavy for a phone: 2x, FXAA or SMAA".to_string())
+    });
+}
+
+fn drain(
+    mut window: Query<(Entity, &mut Window), With<PrimaryWindow>>,
+    mut cursor: MessageWriter<CursorMoved>,
+    mut keys: MessageWriter<KeyboardInput>,
+    mut buttons: MessageWriter<MouseButtonInput>,
+    mut motion: MessageWriter<MouseMotion>,
+    mut wheel: MessageWriter<MouseWheel>,
+    // As winit does: every input also as a WindowEvent. The Pip-Boy's screen (its menus
+    // drawn on the model) reads the buttons from there only (nvf_play::pipboy::drive_pointer).
+    mut window_events: MessageWriter<bevy::window::WindowEvent>,
+) {
+    let events = match QUEUE.lock() {
+        Ok(mut q) if !q.is_empty() => std::mem::take(&mut *q),
+        _ => return,
+    };
+    let Ok((window, mut win)) = window.single_mut() else { return };
+    SCALE.store(win.scale_factor().to_bits(), Ordering::Relaxed);
+    for e in events {
+        match e {
+            Ev::Key(code, down) => {
+                let state = if down { ButtonState::Pressed } else { ButtonState::Released };
+                if let Some(button) = mouse_button(code) {
+                    let b = MouseButtonInput { button, state, window };
+                    window_events.write(bevy::window::WindowEvent::MouseButtonInput(b.clone()));
+                    buttons.write(b);
+                } else if let Some(key_code) = key_code(code) {
+                    let k = KeyboardInput {
+                        key_code,
+                        logical_key: Key::Unidentified(bevy::input::keyboard::NativeKey::Unidentified),
+                        state,
+                        text: None,
+                        repeat: false,
+                        window,
+                    };
+                    window_events.write(bevy::window::WindowEvent::KeyboardInput(k.clone()));
+                    keys.write(k);
+                }
+            }
+            Ev::Motion(dx, dy) => {
+                motion.write(MouseMotion { delta: Vec2::new(dx, dy) });
+            }
+            Ev::CursorTo(x, y) => {
+                let position = Vec2::new(x, y) / win.scale_factor();
+                let delta = win.cursor_position().map(|p| position - p);
+                win.set_physical_cursor_position(Some(bevy::math::DVec2::new(x as f64, y as f64)));
+                let c = CursorMoved { window, position, delta };
+                window_events.write(bevy::window::WindowEvent::CursorMoved(c.clone()));
+                cursor.write(c);
+            }
+            Ev::Scroll(lines) => {
+                let w = MouseWheel { unit: MouseScrollUnit::Line, x: 0.0, y: lines, window, phase: bevy::input::touch::TouchPhase::Moved };
+                window_events.write(bevy::window::WindowEvent::MouseWheel(w.clone()));
+                wheel.write(w);
+            }
+        }
+    }
+}
+
+/// The open screen, the most specific first; else the game's own pointer rules
+/// (nvf_play::player::grab_cursor): a grabbed pointer is play, a free one a menu.
+#[allow(clippy::too_many_arguments)]
+fn publish_ui_state(
+    windows: Query<(&Window, &CursorOptions), With<PrimaryWindow>>,
+    main_menu: Option<Res<nvf_play::main_menu::MainMenu>>,
+    creator: Option<Res<nvf_play::creator::CreatorMenu>>,
+    chargen: Option<Res<nvf_play::chargen::ChargenMenus>>,
+    levelup: Option<Res<nvf_play::levelup::LevelUpMenu>>,
+    paused: Option<Res<nvf_play::pause::Paused>>,
+    pipboy: Option<Res<nvf_play::pipboy::PipBoy>>,
+    talk: Option<Res<nvf_play::dialogue_menu::DialogueMenu>>,
+    message: Option<Res<nvf_play::message_menu::MessagePanel>>,
+    menu: Option<Res<nvf_play::menu::ActiveMenu>>,
+    held: Option<Res<nvf_play::dialogue::WorldHeld>>,
+    look: Option<Res<nvf_play::dialogue::FreeLook>>,
+    locks: Option<Res<nvf_play::control::ControlLocks>>,
+) {
+    let Ok((window, cursor)) = windows.single() else { return };
+    let state = if main_menu.is_some_and(|m| m.open) {
+        6
+    } else if creator.is_some_and(|c| c.is_open()) || chargen.is_some_and(|c| c.progress().is_some()) || levelup.is_some_and(|l| l.progress().is_some()) {
+        7
+    } else if paused.is_some_and(|p| p.0) {
+        8
+    } else if let Some(p) = pipboy.as_ref().filter(|p| p.open()) {
+        // Its map (Data page, local or world map tab): dragged to pan, pinched to zoom.
+        if matches!(p.page, nvf_play::pipboy::Page::Data) && p.tabs[2] <= 1 { 10 } else { 4 }
+    } else if message.is_some_and(|m| m.view.is_some()) {
+        9
+    } else if talk.is_some_and(|t| t.view.is_some()) || held.is_some_and(|h| h.0) || look.is_some_and(|l| l.0) {
+        // The choices, and an actor speaking (free look) between them.
+        5
+    } else if menu.is_some_and(|m| m.0.is_some()) {
+        2
+    } else if locks.is_some_and(|l| l.movement && l.looking) {
+        // A scripted scene: the scripts took both the walk and the look (the birth, the
+        // opening at Doc Mitchell's): nothing on screen to press.
+        3
+    } else if !window.focused || cursor.grab_mode != CursorGrabMode::None {
+        // Out of focus the game frees the pointer whatever it shows: keep every key then.
+        1
+    } else if cursor.visible {
+        2
+    } else {
+        3
+    };
+    UI_STATE.store(state, Ordering::Relaxed);
+}
+
+fn mouse_button(code: i32) -> Option<MouseButton> {
+    Some(match code {
+        272 => MouseButton::Left,
+        273 => MouseButton::Right,
+        274 => MouseButton::Middle,
+        275 => MouseButton::Back,
+        276 => MouseButton::Forward,
+        _ => return None,
+    })
+}
+
+/// Linux evdev key code -> Bevy KeyCode (the keys a PC Fallout uses).
+fn key_code(code: i32) -> Option<KeyCode> {
+    use KeyCode::*;
+    Some(match code {
+        1 => Escape,
+        2 => Digit1, 3 => Digit2, 4 => Digit3, 5 => Digit4, 6 => Digit5,
