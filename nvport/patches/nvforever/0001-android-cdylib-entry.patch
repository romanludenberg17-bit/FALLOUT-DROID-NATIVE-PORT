+/// The references a script's source moves the player to: `player.moveto X`,
+/// `playerref.moveto X` (any case; a trailing comment or arguments ignored).
+fn player_moveto_targets(text: &str) -> Vec<String> {
+    let mut out = Vec::new();
+    for line in text.lines() {
+        let code = line.split(';').next().unwrap_or("");
+        let low = code.to_ascii_lowercase();
+        let mut from = 0;
+        while let Some(i) = low[from..].find("moveto") {
+            let at = from + i;
+            let before = low[..at].trim_end();
+            let ok = before.ends_with("player.") || before.ends_with("playerref.");
+            let rest = code[at + 6..].trim_start();
+            let target: String = rest.chars().take_while(|c| c.is_ascii_alphanumeric() || *c == '_').collect();
+            if ok && !target.is_empty() && !out.contains(&target) {
+                out.push(target);
+            }
+            from = at + 6;
+        }
+    }
+    out
+}
