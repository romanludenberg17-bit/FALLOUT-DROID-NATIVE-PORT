+/// [nvport] Whether the GPU takes BC (DXT) textures. Where a caller has no
+/// `CompressedImageFormatSupport` to hand (the sky asked with `None`), the last answer
+/// seen is used; never seen: no on Android (Mali has none, and a BC texture there is
+/// dropped: the sky and others went missing), yes elsewhere.
+pub fn bc_supported_or_known(formats: Option<&CompressedImageFormatSupport>) -> bool {
+    use std::sync::atomic::{AtomicU8, Ordering};
+    static KNOWN: AtomicU8 = AtomicU8::new(0);
+    match formats {
+        Some(f) => {
+            ETC2_KNOWN.store(if f.0.contains(CompressedImageFormats::ETC2) { 1 } else { 2 }, Ordering::Relaxed);
+            let yes = f.0.contains(CompressedImageFormats::BC);
+            KNOWN.store(if yes { 1 } else { 2 }, Ordering::Relaxed);
+            yes
+        }
+        None => match KNOWN.load(Ordering::Relaxed) {
+            1 => true,
+            2 => false,
+            _ => !cfg!(target_os = "android"),
+        },
+    }
+}
+
+/// [nvport] Whether the GPU takes ETC2 (1 yes, 2 no, 0 not known: Android's Vulkan
+/// baseline has it).
+static ETC2_KNOWN: std::sync::atomic::AtomicU8 = std::sync::atomic::AtomicU8::new(0);
+
+fn etc2_ok() -> bool {
+    cfg!(target_os = "android") && std::env::var_os("NVF_NO_ETC2").is_none() && ETC2_KNOWN.load(std::sync::atomic::Ordering::Relaxed) != 2
+}
