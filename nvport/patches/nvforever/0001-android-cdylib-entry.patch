+                            e.2.insert(n.clone());
+                        }
+                    }
+                    let mut out = String::new();
+                    for (plugin, (n, bad, missing)) in per {
+                        out.push_str(&format!("{plugin}\t{n}\t{bad}\t{}\n", missing.into_iter().collect::<Vec<_>>().join(",")));
+                    }
+                    let _ = std::fs::write(std::path::Path::new(&home).join("mod_report.tsv"), out);
+                }
                 let running = rt.game.quests.values().filter(|q| q.running).count();
                 info!(
                     "scripts ready in {secs:.2} s: {} units, {} scripts, {} quests ({running} start-game-enabled quests running)",
