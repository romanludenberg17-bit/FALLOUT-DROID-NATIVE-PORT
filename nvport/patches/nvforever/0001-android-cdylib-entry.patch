+        return 0;
+    }
+    let p = path.to_ascii_lowercase();
+    if p.contains("interface\\") || p.contains("interface/") || p.contains("menus") || p.contains("fonts") {
+        return 0;
+    }
+    // The distant LOD's textures are low already (one picture for a whole block of cells):
+    // a skipped level smeared the far landscape and buildings.
+    if p.contains("\\lod\\") || p.contains("/lod/") || p.contains("_lod") || p.contains("lod_") || p.contains("\\lod") {
+        return 0;
+    }
+    skip
