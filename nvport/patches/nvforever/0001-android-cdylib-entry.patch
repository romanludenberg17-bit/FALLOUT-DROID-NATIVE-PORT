+/// [nvport] Android entry: NativeActivity/GameActivity loads libnvforever.so and calls this.
+/// The launcher writes the command line (one argument per line) to
+/// `<internal data>/nvport_args.txt`; stderr (the engine's log) goes to
+/// `<external data>/nvforever.log` so the launcher can show and share it.
+#[cfg(target_os = "android")]
+#[unsafe(no_mangle)]
+fn android_main(android_app: bevy::android::android_activity::AndroidApp) {
+    if let Some(ext) = android_app.external_data_path() {
+        let _ = std::fs::create_dir_all(&ext);
+        let log = ext.join("nvforever.log");
+        if let Ok(f) = std::fs::File::create(&log) {
+            use std::os::fd::IntoRawFd;
+            let fd = f.into_raw_fd();
+            // SAFETY: plain dup2 of a file we own onto stdout/stderr.
+            unsafe {
+                libc::dup2(fd, 1);
+                libc::dup2(fd, 2);
+            }
+        }
+    }
+    let mut line = vec!["nvforever".to_string()];
+    if let Some(dir) = android_app.internal_data_path() {
+        if let Ok(text) = std::fs::read_to_string(dir.join("nvport_args.txt")) {
+            for l in text.lines().map(str::trim).filter(|l| !l.is_empty()) {
+                // `env:KEY=VALUE` sets an environment variable (NVFOREVER_HOME,
+                // NVF_PLAY_SCRIPT_FUNCTIONS, ...) before any engine thread starts.
+                if let Some((k, v)) = l.strip_prefix("env:").and_then(|kv| kv.split_once('=')) {
+                    // SAFETY: still single-threaded (before main()).
+                    unsafe { std::env::set_var(k, v) };
+                } else {
+                    line.push(l.to_string());
+                }
+            }
+        }
+    }
+    eprintln!("nvport: android_main, args {line:?}");
+    let _ = ANDROID_ARGS.set(line);
+    let _ = bevy::android::ANDROID_APP.set(android_app);
+    let code = main();
+    eprintln!("nvport: engine exited: {code:?}");
+}
+
+/// [nvport] The command line on Android (see android_main); elsewhere the process's own.
+static ANDROID_ARGS: std::sync::OnceLock<Vec<String>> = std::sync::OnceLock::new();
+
+fn process_args() -> Vec<String> {
+    ANDROID_ARGS.get().cloned().unwrap_or_else(|| std::env::args().collect())
+}
+
