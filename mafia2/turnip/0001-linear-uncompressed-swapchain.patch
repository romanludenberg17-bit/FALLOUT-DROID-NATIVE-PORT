+   /* ReMaf2: unless REMAF2_LINEAR_WSI=0, CPU access flags make gralloc allocate
+    * swapchain buffers linear and without UBWC. Without the vendor gralloc
+    * metadata (NDK builds, Android 16+ mappers) we cannot know a tiled/UBWC
+    * layout, and guessing wrong gives striped frames on Adreno 8xx. */
+   {
+      const char *lin = getenv("REMAF2_LINEAR_WSI");
+      if (!lin || lin[0] != '0')
+         gralloc_usage |= GRALLOC_USAGE_SW_READ_RARELY | GRALLOC_USAGE_SW_WRITE_RARELY;
+   }
+
    if (!gralloc_usage)
